<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="p-6 max-w-4xl mx-auto">
    <div class="mb-6">
      <.link navigate={~p"/dashboard"} class="text-mint-deep hover:text-ink text-sm">
        ← Back to Dashboard
      </.link>
      <h1 class="text-2xl font-bold mt-2 text-ink">{@session.label}</h1>
      <p class="text-steel">{@talk.title}</p>
      <p class="text-muted text-sm mt-1">
        {Calendar.strftime(@session.started_at, "%b %d, %Y %H:%M")}
        <%= if @session.ended_at do %>
          → {Calendar.strftime(@session.ended_at, "%H:%M")}
        <% else %>
          <span class="text-mint-deep">• Active</span>
        <% end %>
      </p>
    </div>

    <div class="mb-8 space-y-4">
      <%!-- items-stretch gives every stat box the height of the tallest one --%>
      <div id="stats" class="flex flex-wrap items-stretch gap-4">
        <div class="px-4 py-3 rounded-lg bg-canvas border border-hairline shadow-[rgba(0,0,0,0.07)_0px_4px_20px]">
          <div class="text-xs text-steel uppercase tracking-wide">Total Reactions</div>
          <div id="total-reactions" class="text-3xl font-bold text-ink">{@total_reactions}</div>
        </div>

        <%= if @audience_count do %>
          <div class="px-4 py-3 rounded-lg bg-canvas border border-hairline shadow-[rgba(0,0,0,0.07)_0px_4px_20px]">
            <div class="text-xs text-steel uppercase tracking-wide">People Reacting</div>
            <div id="audience-count" class="text-3xl font-bold text-ink">{@audience_count}</div>
          </div>
        <% end %>

        <%= if @top_slide do %>
          <% {top_slide_number, top_slide_count} = @top_slide %>
          <div class="px-4 py-3 rounded-lg bg-canvas border border-hairline shadow-[rgba(0,0,0,0.07)_0px_4px_20px]">
            <div class="text-xs text-steel uppercase tracking-wide">Top Slide</div>
            <div id="top-slide" class="text-3xl font-bold text-ink">{top_slide_number}</div>
            <div class="text-xs text-muted">{top_slide_count} reactions</div>
          </div>
        <% end %>

        <%= if @top_emoji do %>
          <% {top_emoji, top_emoji_count} = @top_emoji %>
          <div class="px-4 py-3 rounded-lg bg-canvas border border-hairline shadow-[rgba(0,0,0,0.07)_0px_4px_20px]">
            <div class="text-xs text-steel uppercase tracking-wide">Top Reaction</div>
            <div id="top-emoji" class="text-3xl font-bold text-ink">{top_emoji}</div>
            <div class="text-xs text-muted">{top_emoji_count} reactions</div>
          </div>
        <% end %>
      </div>

      <%= if @session.participant_limit_hit_at do %>
        <%!-- The server writes a UTC fallback; the .LocalTime hook swaps in the
             viewer's local time. phx-update="ignore" stops LiveView from
             overwriting the hook's text on re-render. --%>
        <p id="limit-hit" class="text-sm text-steel">
          Participant limit reached {limit_hit_after(
            @session.started_at,
            @session.participant_limit_hit_at
          )} after the session began (<time
            id="limit-hit-time"
            phx-hook=".LocalTime"
            phx-update="ignore"
            datetime={DateTime.to_iso8601(@session.participant_limit_hit_at)}
          >{Calendar.strftime(@session.participant_limit_hit_at, "%-I:%M %p UTC")}</time>)
        </p>
      <% end %>

      <%= if length(@other_sessions) > 0 do %>
        <div id="compare-link" class="text-sm">
          <span class="text-steel">Compare with: </span>
          <%= for %{session: other} <- @other_sessions do %>
            <.link
              navigate={~p"/sessions/#{@session.id}/compare/#{other.id}"}
              class="text-mint-deep hover:text-ink mr-3"
            >
              {other.label}
            </.link>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= if @timeline do %>
      <section
        id="timeline-card"
        class="mb-8 p-4 rounded-lg bg-canvas border border-hairline shadow-[rgba(0,0,0,0.07)_0px_4px_20px]"
      >
        <h2 class="text-sm font-semibold text-steel mb-2">Reactions over time</h2>
        <%!-- The hook draws the chart inside this div. phx-update="ignore"
             stops LiveView from wiping the chart's SVG on re-render. --%>
        <div
          id="reaction-timeline"
          phx-hook=".ReactionTimeline"
          phx-update="ignore"
          role="img"
          aria-label={timeline_label(@timeline)}
          data-timeline={Jason.encode!(@timeline)}
          class="w-full h-60"
        >
        </div>
      </section>
    <% end %>

    <%= if @by_slide == %{} do %>
      <p id="no-reactions" class="text-muted">No reactions recorded in this session.</p>
    <% else %>
      <div class="space-y-6">
        <%= for slide_number <- @by_slide |> Map.keys() |> Enum.sort() do %>
          <% entries = @by_slide[slide_number] %>
          <% max_count = entries |> Enum.map(& &1.count) |> Enum.max(fn -> 1 end) %>
          <div
            id={"slide-row-#{slide_number}"}
            class="p-4 rounded-lg bg-canvas border border-hairline shadow-[rgba(0,0,0,0.07)_0px_4px_20px]"
          >
            <div class="text-sm font-semibold text-steel mb-3">
              {if slide_number == 0, do: "General", else: "Slide #{slide_number}"}
              <%= if people = @slide_people[slide_number] do %>
                <span id={"slide-people-#{slide_number}"} class="ml-2 font-normal text-muted">
                  {if people == 1, do: "1 person", else: "#{people} people"}
                </span>
              <% end %>
            </div>
            <div class="space-y-2">
              <%= for %{emoji: emoji, count: count} <- Enum.sort_by(entries, & &1.count, :desc) do %>
                <div class="flex items-center gap-3">
                  <span class="text-xl w-8">{emoji}</span>
                  <div class="flex-1 bg-surface rounded-full h-4 overflow-hidden">
                    <div
                      class="h-full bg-mint rounded-full transition-all"
                      style={"width: #{Float.round(count / max_count * 100, 1)}%"}
                    >
                    </div>
                  </div>
                  <span class="text-steel text-sm w-8 text-right">{count}</span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= if @compare_session do %>
      <% all_slides =
        (Map.keys(@by_slide) ++ Map.keys(@compare_by_slide)) |> Enum.uniq() |> Enum.sort() %>
      <div id="compare-section" class="mt-10 pt-8 border-t border-hairline">
        <h2 class="text-xl font-semibold text-ink mb-6">
          Comparing <span class="text-blue-600">{@session.label}</span>
          vs <span class="text-purple-600">{@compare_session.label}</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <%= for {slide_data, label_color} <- [{@by_slide, "text-blue-600"}, {@compare_by_slide, "text-purple-600"}] do %>
            <% session_label =
              if slide_data == @by_slide, do: @session.label, else: @compare_session.label %>
            <div>
              <h3 class={["font-medium mb-4", label_color]}>{session_label}</h3>
              <div class="space-y-4">
                <%= for slide_number <- all_slides do %>
                  <% entries = Map.get(slide_data, slide_number, []) %>
                  <% max_count = entries |> Enum.map(& &1.count) |> Enum.max(fn -> 1 end) %>
                  <div class="p-3 rounded-lg bg-canvas border border-hairline shadow-[rgba(0,0,0,0.07)_0px_4px_20px]">
                    <div class="text-xs font-semibold text-steel mb-2">
                      {if slide_number == 0, do: "General", else: "Slide #{slide_number}"}
                    </div>
                    <%= if entries == [] do %>
                      <div class="text-xs text-muted">No reactions</div>
                    <% else %>
                      <%= for %{emoji: emoji, count: count} <- Enum.sort_by(entries, & &1.count, :desc) do %>
                        <div class="flex items-center gap-2 mb-1">
                          <span class="text-base w-6">{emoji}</span>
                          <div class="flex-1 bg-surface rounded-full h-3 overflow-hidden">
                            <div
                              class="h-full bg-mint rounded-full"
                              style={"width: #{Float.round(count / max_count * 100, 1)}%"}
                            >
                            </div>
                          </div>
                          <span class="text-steel text-xs w-6 text-right">{count}</span>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".LocalTime">
    // Rewrites the <time> element's text to the viewer's own time zone. The
    // server cannot know that zone, so it renders UTC and this hook replaces it.
    function showLocalTime(el) {
      const date = new Date(el.getAttribute("datetime"))
      // An unparseable value gives an "Invalid Date" whose time is NaN. Leave
      // the server's UTC text alone in that case.
      if (isNaN(date)) return
      el.textContent = date.toLocaleTimeString([], {
        hour: "numeric",
        minute: "2-digit",
        timeZoneName: "short",
      })
    }

    export default {
      mounted() {
        showLocalTime(this.el)
      },
      updated() {
        showLocalTime(this.el)
      },
    }
  </script>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".ReactionTimeline">
    // The vendored, tree-shaken ECharts build lives in assets/vendor/echarts.custom.js.
    // It is loaded with a dynamic import() in mounted(), so esbuild puts it in
    // its own chunk and only this page downloads it.

    // Brand colours as hex, because ECharts draws its own SVG and cannot use
    // Tailwind classes.
    const MINT = "#00d4a4"
    const MINT_DEEP = "#00b48a"
    const INK = "#0a0a0a"
    const STEEL = "#5a5a5c"
    const HAIRLINE = "#e5e5e5"

    // Seconds as m:ss, e.g. 75 -> "1:15". Matches the server's aria-label.
    const clock = (seconds) =>
      `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`

    // Builds the ECharts "option" object: a plain description of the chart
    // that ECharts turns into SVG.
    function buildOption(data, description, fontFamily) {
      const {bucket_seconds: bucket, counts, peak, slide_starts: slideStarts} = data
      const last = counts.length - 1

      // Which slides first got a reaction in each bucket: {bucketIndex: [slide, ...]}.
      // A slide whose first reaction came after the session ended lies past the
      // end of the axis, so it is clamped into the last bucket.
      const slidesByBucket = {}
      for (const {slide, offset_seconds} of slideStarts) {
        const index = Math.min(Math.floor(offset_seconds / bucket), last)
        // Start a list for this bucket the first time, then add the slide to it.
        if (!slidesByBucket[index]) slidesByBucket[index] = []
        slidesByBucket[index].push(slide)
      }

      // One entry per bar. A bar can carry its own colour and label, which is
      // how the peak gets the deeper mint and how slide starts get "Slide N".
      // The labels belong to the bar series (not a markPoint) so that the
      // series' labelLayout.hideOverlap can hide colliding ones; ECharts only
      // runs that overlap check on series labels.
      const bars = counts.map((count, index) => {
        const slides = slidesByBucket[index] || []
        const lines = []
        // In rich text, `{name|text}` styles "text" with the style called "name" from label.rich.
        if (index === peak.index) lines.push(`{peak|Peak: ${count}}`)
        if (slides.length > 0) lines.push(`Slide ${slides[0]}${slides.length > 1 ? "+" : ""}`)

        return {
          value: count,
          itemStyle: {color: index === peak.index ? MINT_DEEP : MINT},
          label: lines.length > 0 ? {show: true, formatter: lines.join("\n")} : {show: false},
        }
      })

      return {
        // Lets screen readers read our summary instead of a generated one.
        aria: {enabled: true, label: {description}},
        animation: false,
        // The page's own font. "inherit" does not work here: ECharts writes a
        // CSS `font` shorthand, which the browser rejects when it contains
        // "inherit", and the text then falls back to 16px.
        textStyle: {fontFamily, color: STEEL},
        // containLabel keeps the axis labels inside the box, so nothing spills
        // past the container on a narrow phone screen.
        grid: {left: 4, right: 24, top: 40, bottom: 4, containLabel: true},
        xAxis: {
          type: "category",
          data: counts.map((_, index) => clock(index * bucket)),
          axisLine: {lineStyle: {color: HAIRLINE}},
          axisTick: {show: false},
          axisLabel: {color: STEEL, fontSize: 11, hideOverlap: true},
        },
        yAxis: {
          type: "value",
          minInterval: 1, // whole reactions only, never 0.5
          axisLabel: {color: STEEL, fontSize: 11},
          splitLine: {lineStyle: {color: HAIRLINE}},
        },
        tooltip: {
          trigger: "axis", // one tooltip per bucket, wherever the pointer is in it
          axisPointer: {type: "shadow"},
          textStyle: {color: INK, fontSize: 12},
          borderColor: HAIRLINE,
          // Plain text built by hand, so a slide label hidden by overlap is
          // still listed here.
          formatter: (params) => {
            const index = params[0].dataIndex
            const count = counts[index]
            const rows = [
              `<strong>${clock(index * bucket)}–${clock((index + 1) * bucket)}</strong>`,
              `${count} ${count === 1 ? "reaction" : "reactions"}`,
            ]
            for (const slide of slidesByBucket[index] || []) rows.push(`Slide ${slide} starts here`)
            return rows.join("<br>")
          },
        },
        series: [
          {
            type: "bar",
            data: bars,
            barMaxWidth: 32,
            label: {
              position: "top",
              color: STEEL,
              fontSize: 11,
              lineHeight: 14,
              align: "center",
              // A light backing keeps a label readable where it sits over a
              // neighbouring, taller bar.
              backgroundColor: "rgba(255, 255, 255, 0.85)",
              padding: [1, 2],
              borderRadius: 2,
              // Rich-text style for the "Peak: N" line.
              rich: {peak: {color: INK, fontWeight: "bold", fontSize: 12, lineHeight: 16}},
            },
            // Hide a label that would overlap another rather than overprint it.
            labelLayout: {hideOverlap: true},
          },
        ],
      }
    }

    export default {
      async mounted() {
        const data = JSON.parse(this.el.dataset.timeline)
        // `@` is an esbuild alias for the assets/ folder.
        const {init} = await import("@/vendor/echarts.custom")
        // LiveView may have removed the element while the chunk was loading.
        if (this.isDestroyed) return

        // SVG gives crisp text and lets browser tests find the chart's <svg>.
        this.chart = init(this.el, null, {renderer: "svg"})
        const fontFamily = getComputedStyle(this.el).fontFamily
        this.chart.setOption(buildOption(data, this.el.getAttribute("aria-label"), fontFamily))

        // Redraw at the new size whenever the container changes width, for
        // example when a phone rotates or the window is resized.
        this.resizeObserver = new ResizeObserver(() => this.chart.resize())
        this.resizeObserver.observe(this.el)
      },

      destroyed() {
        this.isDestroyed = true
        // Free the observer and the chart's memory when LiveView removes it.
        // The ?. skips the call if mounted() failed before creating them.
        this.resizeObserver?.disconnect()
        this.chart?.dispose()
      },
    }
  </script>
</Layouts.app>
