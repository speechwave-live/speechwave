<Layouts.app flash={@flash} current_scope={@current_scope} full_width>
  <div class="min-h-screen bg-canvas px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl space-y-4">
      <h1 class="text-2xl font-bold text-ink mb-2">Admin Stats</h1>
      <div id="admin-stats-grid" class="grid grid-cols-1 gap-4">
        <.admin_stat_card
          :for={{key, stat} <- @stats}
          id={dom_id(key)}
          title={title_for(key)}
          current={stat.current}
          chart_svg={stat.chart_svg}
          strip_svg={Map.get(stat, :strip_svg)}
          strip_label={Map.get(stat, :strip_label)}
        />
      </div>

      <section
        id="consent-export"
        class="rounded-2xl border border-hairline bg-surface p-5 space-y-4"
      >
        <div>
          <h2 class="text-lg font-semibold text-ink">Email consent export</h2>
          <p class="text-sm text-ink/70">
            Downloads a CSV of confirmed users who currently consent to marketing email.
            All filters are optional.
          </p>
        </div>

        <.form
          for={@export_form}
          id="consent-export-form"
          action={~p"/admin/consent-export"}
          method="get"
          phx-change="export_changed"
          class="space-y-2"
        >
          <div>
            <.input
              field={@export_form[:source]}
              id="export-source"
              type="select"
              label="Source"
              prompt="All sources"
              options={@source_options}
            />
            <p id="export-source-hint" class="text-xs text-steel">
              Where the user agreed to marketing email. <code>login</code>
              means at sign-in; <code>pricing_pro</code>
              and <code>pricing_enterprise</code>
              mean they asked to be notified about that plan on the pricing page.
              Only sources that currently have consenting users are listed.
            </p>
          </div>
          <.input
            field={@export_form[:any_time]}
            id="export-any-time"
            type="checkbox"
            label="Consented at any time (ignore the dates below)"
            checked={@any_time}
          />
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <.input
              field={@export_form[:from]}
              id="export-from"
              type="date"
              label="Consented from"
              disabled={@any_time}
            />
            <.input
              field={@export_form[:to]}
              id="export-to"
              type="date"
              label="Consented to"
              disabled={@any_time}
            />
          </div>
          <.button id="consent-export-submit" type="submit" variant="primary">
            Download CSV
          </.button>
        </.form>
      </section>
    </div>
  </div>
</Layouts.app>
