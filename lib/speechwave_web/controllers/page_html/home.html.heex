<Layouts.public_nav current_scope={@current_scope} />

<%!-- Hero --%>
<section class="pt-40 pb-28 px-6 bg-gradient-to-b from-hero-sky-from to-hero-sky-to">
  <div class="max-w-4xl mx-auto text-center">
    <h1 class="text-5xl sm:text-6xl lg:text-[62px] font-semibold text-ink tracking-tight leading-[1.05] mb-6">
      Keep your audience engaged<br class="hidden sm:block" /> from start to finish
    </h1>

    <p class="text-lg sm:text-xl text-steel max-w-2xl mx-auto mb-10 leading-relaxed">
      Your audience reacts with emoji in real time while you present, giving
      you instant feedback and per slide analytics later to help you improve.
    </p>

    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href={~p"/users/log-in"}
        class="px-5 py-2.5 text-sm font-medium text-ink bg-mint rounded-full hover:bg-mint-deep transition-colors hover:-translate-y-px transform inline-block"
      >
        Get started free
      </a>
      <a
        href={~p"/pricing"}
        class="px-5 py-2.5 text-sm font-medium text-ink border border-[rgba(10,10,10,0.2)] rounded-full hover:bg-white/30 transition-colors inline-block"
      >
        See pricing
      </a>
    </div>
  </div>
</section>

<%!-- Demo section --%>
<section class="py-20 px-6 bg-canvas" id="demo-section">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-12">
      <p class="text-[11px] font-semibold text-steel uppercase tracking-[0.5px] mb-3">
        See it in action
      </p>
      <h2 class="text-3xl sm:text-[36px] font-semibold text-ink tracking-tight">
        The full experience, at a glance
      </h2>
    </div>

    <%!-- Top row: presentation panel + phone (stacks on mobile) --%>
    <div class="flex flex-col sm:flex-row gap-5 mb-5 items-start">
      <%!-- Presentation panel --%>
      <div class="sm:flex-[1.6] w-full bg-canvas rounded-2xl border border-hairline shadow-[rgba(0,0,0,0.07)_0px_4px_20px] overflow-hidden">
        <div class="px-4 py-3 border-b border-hairline-soft bg-surface-soft flex items-center gap-3">
          <div class="flex gap-1.5 shrink-0">
            <span class="size-2.5 rounded-full bg-[#ff5f57] inline-block"></span>
            <span class="size-2.5 rounded-full bg-[#ffbd2e] inline-block"></span>
            <span class="size-2.5 rounded-full bg-[#28c940] inline-block"></span>
          </div>
          <span class="text-[11px] text-muted flex-1 text-center">
            Google Slides presentation
          </span>
        </div>
        <div class="px-8 pt-8 pb-6 relative min-h-[220px]">
          <div class="text-center mb-4">
            <h3 class="text-lg font-semibold text-ink tracking-tight mb-2">
              Introducing Speechwave
            </h3>
            <p class="text-sm text-steel">Get better engagement <i>and</i> improvement feedback!</p>
            <div class="flex gap-2 justify-center mt-4">
              <span class="text-xs font-medium text-mint-deep bg-[#f0f9f6] border border-[#c5f0e4] rounded-full px-3 py-1">
                Continuous engagement
              </span>
              <span class="text-xs font-medium text-mint-deep bg-[#f0f9f6] border border-[#c5f0e4] rounded-full px-3 py-1">
                Per-slide analytics
              </span>
            </div>
          </div>
          <%!-- Float overlay: lower-right corner, ~35% wide × 45% tall of slide body --%>
          <div class="demo-emoji-overlay" id="demo-emoji-overlay"></div>
        </div>
      </div>

      <%!-- Phone panel --%>
      <div class="sm:flex-1 w-full flex justify-center">
        <div class="demo-phone-bezel">
          <div class="demo-phone-notch"></div>
          <div class="demo-phone-screen">
            <div class="flex justify-between items-center px-3 py-1.5 bg-surface-soft border-b border-hairline-soft">
              <span class="text-[8px] font-semibold text-ink">9:41</span>
              <span class="text-[8px] text-ink">●●●</span>
            </div>
            <div class="px-3.5 py-3">
              <p class="text-[9px] font-semibold text-ink mb-0.5">Introducing Speechwave</p>
              <p class="text-[8px] text-muted mb-3.5">React live while you listen</p>
              <div class="grid grid-cols-3 gap-2.5 place-items-center mb-3" id="demo-emoji-grid">
                <div class="demo-emoji-btn" id="demo-btn-0">❤️</div>
                <div class="demo-emoji-btn" id="demo-btn-1">😂</div>
                <div class="demo-emoji-btn" id="demo-btn-2">👏</div>
                <div class="demo-emoji-btn" id="demo-btn-3">🤯</div>
                <div class="demo-emoji-btn" id="demo-btn-4">🎉</div>
                <div class="demo-emoji-btn" id="demo-btn-5">😮</div>
              </div>
              <p class="text-[8px] text-muted text-center">Tap to react</p>
            </div>
          </div>
          <div class="demo-phone-home-bar"></div>
        </div>
      </div>
    </div>

    <%!-- Analytics panel --%>
    <div class="bg-canvas rounded-2xl border border-hairline shadow-[rgba(0,0,0,0.07)_0px_4px_20px] overflow-hidden">
      <div class="px-4 py-3 border-b border-hairline-soft bg-surface-soft flex items-center gap-3">
        <div class="flex gap-1.5 shrink-0">
          <span class="size-2.5 rounded-full bg-[#ff5f57] inline-block"></span>
          <span class="size-2.5 rounded-full bg-[#ffbd2e] inline-block"></span>
          <span class="size-2.5 rounded-full bg-[#28c940] inline-block"></span>
        </div>
        <span class="text-[11px] text-muted flex-1 text-center">Session analytics</span>
      </div>
      <div class="flex flex-col sm:flex-row gap-6 sm:gap-8 p-6">
        <%!-- Summary stats --%>
        <div class="flex sm:flex-col gap-6 sm:gap-4 shrink-0">
          <div>
            <div class="text-3xl font-semibold text-ink leading-none mb-1">247</div>
            <div class="text-[10px] text-muted">Total reactions</div>
          </div>
          <div>
            <div class="text-3xl font-semibold text-ink leading-none mb-1">34</div>
            <div class="text-[10px] text-muted">Audience</div>
          </div>
        </div>
        <%!-- Per-slide breakdown — wraps on mobile --%>
        <div class="flex flex-wrap gap-4 flex-1">
          <%= for {slide_label, bars} <- [
            {"Slide 1", [{"❤️", 85, 42}, {"😂", 55, 27}, {"👏", 40, 20}, {"🎉", 30, 15}]},
            {"Slide 3", [{"🤯", 90, 36}, {"😮", 70, 28}, {"👏", 50, 20}, {"❤️", 25, 10}]},
            {"Slide 5", [{"👏", 100, 51}, {"❤️", 65, 33}, {"🎉", 45, 23}, {"😂", 20, 10}]},
            {"Slide 7", [{"🎉", 80, 32}, {"😮", 60, 24}, {"❤️", 35, 14}, {"🤯", 18, 7}]}
          ] do %>
            <div class="min-w-[130px] flex-1">
              <p class="text-[10px] font-semibold text-steel uppercase tracking-[0.3px] mb-2">
                {slide_label}
              </p>
              <%= for {emoji, pct, count} <- bars do %>
                <div class="flex items-center gap-1.5 mb-1.5">
                  <span class="text-xs w-4 text-center">{emoji}</span>
                  <div class="flex-1 h-1.5 bg-surface rounded-full overflow-hidden">
                    <div class="h-full bg-mint rounded-full" style={"width: #{pct}%"}></div>
                  </div>
                  <span class="text-[9px] text-muted w-4 text-right">{count}</span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<%!-- How it works --%>
<section class="py-24 px-6 bg-canvas">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-16">
      <p class="text-[11px] font-semibold text-steel uppercase tracking-[0.5px] mb-3">
        How it works
      </p>
      <h2 class="text-3xl sm:text-[36px] font-semibold text-ink tracking-tight">
        Up and running in minutes
      </h2>
      <p class="text-steel mt-3 max-w-sm mx-auto text-sm leading-relaxed">
        No complicated setup. Works with Google Slides today.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="p-8 rounded-xl border border-hairline bg-surface">
        <div class="text-white bg-mint size-8 rounded-full border border-hairline flex items-center justify-center text-xs font-semibold text-steel mb-6">
          1
        </div>
        <h3 class="text-base font-semibold text-ink mb-2">Install the extension</h3>
        <p class="text-sm text-steel leading-relaxed">
          Add the Speechwave Chrome extension and paste your API key from your account settings.
        </p>
      </div>
      <div class="p-8 rounded-xl border border-hairline bg-surface">
        <div class="text-white bg-mint bg-canvas size-8 rounded-full border border-hairline flex items-center justify-center text-xs font-semibold text-steel mb-6">
          2
        </div>
        <h3 class="text-base font-semibold text-ink mb-2">Share the QR code</h3>
        <p class="text-sm text-steel leading-relaxed">
          Add the Speechwave URL to your first slide. Your audience scans it to join the reaction page instantly.
        </p>
      </div>
      <div class="p-8 rounded-xl border border-hairline bg-surface">
        <div class="text-white bg-mint bg-canvas size-8 rounded-full border border-hairline flex items-center justify-center text-xs font-semibold text-steel mb-6">
          3
        </div>
        <h3 class="text-base font-semibold text-ink mb-2">Watch the reactions</h3>
        <p class="text-sm text-steel leading-relaxed">
          Emoji reactions float up on your screen in real time as your audience taps. Feel the energy in the room.
        </p>
      </div>
    </div>
  </div>
</section>

<%!-- Features --%>
<section class="py-24 px-6 bg-surface">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-16">
      <p class="text-[11px] font-semibold text-steel uppercase tracking-[0.5px] mb-3">
        Everything included
      </p>
      <h2 class="text-3xl sm:text-[36px] font-semibold text-ink tracking-tight">
        Everything you need on the free plan
      </h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="p-6 bg-canvas rounded-xl border border-hairline">
        <.icon name="hero-face-smile" class="size-5 text-steel mb-4" />
        <h3 class="text-sm font-semibold text-ink mb-1.5">Live emoji reactions</h3>
        <p class="text-sm text-steel leading-relaxed">
          Get continuous engagement throughout your entire talk.
        </p>
      </div>
      <div class="p-6 bg-canvas rounded-xl border border-hairline">
        <.icon name="hero-chart-bar" class="size-5 text-steel mb-4" />
        <h3 class="text-sm font-semibold text-ink mb-1.5">Per Slide Session analytics</h3>
        <p class="text-sm text-steel leading-relaxed">
          Get better every time you give your talk with
          per slide reaction stats.
        </p>
      </div>
      <div class="p-6 bg-canvas rounded-xl border border-hairline">
        <.icon name="hero-qr-code" class="size-5 text-steel mb-4" />
        <h3 class="text-sm font-semibold text-ink mb-1.5">QR code sharing</h3>
        <p class="text-sm text-steel leading-relaxed">
          Auto-generated QR code for instant audience access.
        </p>
      </div>
      <div class="p-6 bg-canvas rounded-xl border border-hairline">
        <.icon name="hero-sparkles" class="size-5 text-steel mb-4" />
        <h3 class="text-sm font-semibold text-ink mb-1.5">Fireworks mode</h3>
        <p class="text-sm text-steel leading-relaxed">
          When reactions converge, the fireworks animation rewards your audience.
        </p>
      </div>
      <div class="p-6 bg-canvas rounded-xl border border-hairline">
        <.icon name="hero-lock-closed" class="size-5 text-steel mb-4" />
        <h3 class="text-sm font-semibold text-ink mb-1.5">Secure by default</h3>
        <p class="text-sm text-steel leading-relaxed">
          Only you can start sessions for your talks.
        </p>
      </div>
      <div class="p-6 bg-canvas rounded-xl border border-hairline">
        <.icon name="hero-gift" class="size-5 text-steel mb-4" />
        <h3 class="text-sm font-semibold text-ink mb-1.5">Free forever</h3>
        <p class="text-sm text-steel leading-relaxed">
          The free plan has no time limit. Upgrade when you're ready.
        </p>
      </div>
    </div>
  </div>
</section>

<%!-- Testimonial --%>
<section class="py-24 px-6 bg-canvas">
  <div class="max-w-2xl mx-auto">
    <div class="bg-surface rounded-xl border border-hairline p-8">
      <p class="text-[28px] text-on-dark-muted leading-none mb-4 font-serif select-none">
        &ldquo;
      </p>
      <blockquote class="text-base text-ink leading-relaxed mb-6">
        [Speechwave] added a unique and engaging element to the session, and it
        was great to see the team interact with it in real time. The analytics
        component is especially interesting.
      </blockquote>
      <div>
        <p class="text-sm font-medium text-ink">Shannon Joyce</p>
        <p class="text-sm text-steel">Prime Medicine</p>
      </div>
    </div>
  </div>
</section>

<%!-- CTA band --%>
<section class="py-24 px-6 bg-canvas-dark">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="text-3xl sm:text-[36px] font-semibold text-on-dark tracking-tight mb-4">
      Energize your next talk
    </h2>
    <p class="text-on-dark-muted mb-10 leading-relaxed max-w-md mx-auto">
      Create your free account and have continuous engagement and live feedback analytics for your next talk.
    </p>
    <a
      href={~p"/users/log-in"}
      class="inline-block px-5 py-2.5 text-sm font-medium text-ink bg-on-dark rounded-full hover:bg-[#f0f0f0] transition-colors"
    >
      Get started free
    </a>
  </div>
</section>

<Layouts.public_footer />
