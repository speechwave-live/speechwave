<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Something went wrong · Speechwave</title>
    <link rel="stylesheet" href="/assets/css/app.css" />
  </head>
  <body class="font-sans antialiased bg-white">
    <header class="border-b border-hairline">
      <div class="max-w-6xl mx-auto px-6 h-14 flex items-center">
        <a href="/" class="flex items-center gap-2 text-ink font-semibold text-sm">
          <img src={~p"/images/logo.svg"} alt="" class="w-5 h-5" /> Speechwave
        </a>
      </div>
    </header>
    <main class="flex flex-col items-center justify-center min-h-[70vh] px-6 text-center">
      <p class="text-sm font-semibold text-mint uppercase tracking-widest mb-4">500</p>
      <h1 class="text-3xl sm:text-4xl font-semibold text-ink mb-3">Something went wrong</h1>
      <p class="text-steel mb-8 max-w-sm">
        We're having trouble on our end. Please try again in a moment.
      </p>
      <a
        href="/"
        class="px-5 py-2.5 text-sm font-medium text-ink bg-mint rounded-full hover:bg-mint-deep transition-colors"
      >
        Go home
      </a>
    </main>
  </body>
</html>
